{
  "name": "@duraflows/monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "tsc --build && tsc --build tsconfig.cjs.json && sh scripts/add-cjs-package-json.sh",
    "clean": "tsc --build --clean && tsc --build --clean tsconfig.cjs.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "vitest --typecheck.enabled --run",
    "lint": "eslint packages/*/src/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "release-it",
    "security:secrets": "gitleaks detect --no-banner",
    "security:audit": "pnpm audit"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^10.0.1",
    "@release-it/conventional-changelog": "^11.0.0",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "lefthook": "^2.1.4",
    "prettier": "^3.8.3",
    "release-it": "^20.0.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "overrides": {
      "basic-ftp": ">=5.3.0",
      "path-to-regexp": "^8.4.0",
      "typescript": "^5.7.0",
      "undici": ">=6.24.0"
    }
  },
  "skills": {
    "duraflows-developer": "skills/duraflows-developer/SKILL.md",
    "duraflows-builder": "skills/duraflows-builder/SKILL.md",
    "duraflows-tester": "skills/duraflows-tester/SKILL.md",
    "duraflows-persistence-adapter": "skills/duraflows-persistence-adapter/SKILL.md",
    "duraflows-reviewer": "skills/duraflows-reviewer/SKILL.md"
  },
  "version": "1.1.0",
  "license": "MIT"
}

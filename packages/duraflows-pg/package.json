{
  "name": "@duraflows/pg",
  "version": "1.1.0",
  "description": "PostgreSQL persistence adapter for duraflows using `pg`. Provides transaction runner, workflow instance store, and history store with row-level locking for safe concurrent access.",
  "keywords": [
    "duraflows",
    "workflow",
    "postgresql",
    "pg",
    "persistence",
    "durable",
    "state-machine"
  ],
  "author": "Carlos Cima",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/camcima/duraflows#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/camcima/duraflows.git",
    "directory": "packages/duraflows-pg"
  },
  "bugs": {
    "url": "https://github.com/camcima/duraflows/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "@duraflows/core": "^1.1.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0"
  }
}

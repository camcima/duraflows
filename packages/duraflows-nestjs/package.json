{
  "name": "@duraflows/nestjs",
  "version": "2.1.0",
  "description": "NestJS integration for duraflows: dependency injection, services, optional REST controllers, and @WorkflowCommand decorator for DI-backed command handlers.",
  "keywords": [
    "duraflows",
    "workflow",
    "nestjs",
    "dependency-injection",
    "decorator",
    "durable",
    "state-machine"
  ],
  "author": "Carlos Cima",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/camcima/duraflows#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/camcima/duraflows.git",
    "directory": "packages/duraflows-nestjs"
  },
  "bugs": {
    "url": "https://github.com/camcima/duraflows/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1"
  },
  "peerDependencies": {
    "@duraflows/core": "^2.1.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.0.0"
  },
  "devDependencies": {
    "@duraflows/core": "workspace:*",
    "@nestjs/common": "^11.1.24",
    "@nestjs/core": "^11.1.24",
    "@nestjs/testing": "^11.1.24"
  }
}

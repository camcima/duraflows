{
  "name": "@duraflows/kysely",
  "version": "1.1.0",
  "description": "PostgreSQL persistence adapter for duraflows using `kysely`. Integrates with kysely's type-safe query builder and AsyncLocalStorage-based transaction context.",
  "keywords": [
    "duraflows",
    "workflow",
    "postgresql",
    "kysely",
    "persistence",
    "durable",
    "state-machine",
    "type-safe"
  ],
  "author": "Carlos Cima",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/camcima/duraflows#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/camcima/duraflows.git",
    "directory": "packages/duraflows-kysely"
  },
  "bugs": {
    "url": "https://github.com/camcima/duraflows/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "@duraflows/core": "^1.1.0",
    "kysely": "^0.28.16"
  },
  "peerDependencies": {
    "pg": "^8.13.0"
  }
}

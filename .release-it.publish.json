{
  "git": {
    "commit": false,
    "tag": true,
    "tagName": "v${version}",
    "push": false,
    "requireUpstream": false,
    "requireCleanWorkingDir": true
  },
  "github": {
    "release": true,
    "releaseName": "v${version}",
    "releaseNotes": "node scripts/extract-release-notes.mjs ${version}"
  },
  "npm": { "publish": false },
  "hooks": {
    "after:git:release": "git push origin v${version}",
    "before:github:release": "pnpm -r publish --no-git-checks"
  }
}
